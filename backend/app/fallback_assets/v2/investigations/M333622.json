        "sql": "WITH __obs AS (\n  SELECT\n    compliance_status,\n    metric_id,\n    test_result,\n    test_status,\n    eon_id,\n    reporting_monthend_date,\n    is_denominator AS denominator_flag,\n    is_numerator AS numerator_flag\n  FROM METRICS_ANALYZER.MOCK_DATA.APPLICATION_COMPLIANCE\n)\nSELECT\n  reporting_monthend_date AS m,\n  SUM(numerator_flag) AS num,\n  SUM(denominator_flag) AS den,\n  SUM(numerator_flag) / NULLIF(NULLIF(SUM(denominator_flag), 0), 0) AS rate,\n  COUNT(*) AS rows_,\n  COUNT(DISTINCT eon_id) AS apps,\n  COUNT_IF(compliance_status = 'Non_Compliant') AS nc,\n  COUNT_IF(compliance_status = 'Pending') AS pend,\n  COUNT_IF(test_status = 'Test_Complete' AND test_result = 'Fail') AS failed,\n  COUNT_IF(test_status = 'Test_Complete' AND test_result = 'Pass') AS passed,\n  COUNT_IF(test_status = 'Test_Pending') AS tpend,\n  COUNT_IF(test_status = 'No_Test') AS notest,\n  COUNT_IF(test_status = 'Exempt') AS exempt\nFROM __obs\nWHERE\n  metric_id = 'M333622'\nGROUP BY\n  1\nORDER BY\n  1 /* Generated by Cortex */;",
