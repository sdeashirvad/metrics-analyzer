        "toolName": "system_execute_sql",
        "sql": "WITH __obs AS (\n  SELECT\n    compliance_status,\n    metric_id,\n    eon_id,\n    reporting_monthend_date\n  FROM METRICS_ANALYZER.MOCK_DATA.APPLICATION_COMPLIANCE\n), c AS (\n  SELECT\n    eon_id,\n    compliance_status AS s\n  FROM __obs\n  WHERE\n    metric_id = 'M333622' AND reporting_monthend_date = '2026-10-31'\n), p AS (\n  SELECT\n    eon_id,\n    compliance_status AS s\n  FROM __obs\n  WHERE\n    metric_id = 'M333622' AND reporting_monthend_date = '2026-09-30'\n)\nSELECT\n  CASE\n    WHEN p.eon_id IS NULL\n    THEN 'NO_PRIOR_MONTH'\n    WHEN c.s = 'Non_Compliant' AND p.s = 'Non_Compliant'\n    THEN 'PERSISTENT_NON_COMPLIANT'\n    WHEN c.s = 'Non_Compliant'\n    THEN 'NEWLY_NON_COMPLIANT'\n    WHEN p.s = 'Non_Compliant'\n    THEN 'RESOLVED'\n    ELSE 'OTHER'\n  END AS movement,\n  COUNT(*) AS apps,\n  (\n    SELECT\n      COUNT(*)\n    FROM p\n    WHERE\n      eon_id <> ALL (\n        SELECT\n          eon_id\n        FROM c\n      )\n  ) AS only_prior\nFROM c\nLEFT JOIN p\n  ON c.eon_id = p.eon_id\nGROUP BY\n  1\nORDER BY\n  1 /* Generated by Cortex */;",
