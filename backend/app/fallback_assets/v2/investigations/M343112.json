        "sql": "WITH __obs AS (\n  SELECT\n    compliance_status,\n    metric_id,\n    eon_id,\n    reporting_monthend_date,\n    is_denominator AS denominator_flag,\n    is_numerator AS numerator_flag\n  FROM METRICS_ANALYZER.MOCK_DATA.APPLICATION_COMPLIANCE\n), c AS (\n  SELECT\n    eon_id,\n    numerator_flag AS n,\n    denominator_flag AS d,\n    compliance_status AS s\n  FROM __obs\n  WHERE\n    metric_id = 'M343112' AND reporting_monthend_date = '2026-10-31'\n), p AS (\n  SELECT\n    eon_id,\n    numerator_flag AS n,\n    denominator_flag AS d,\n    compliance_status AS s\n  FROM __obs\n  WHERE\n    metric_id = 'M343112' AND reporting_monthend_date = '2026-09-30'\n)\nSELECT\n  CASE\n    WHEN NOT c.eon_id IS NULL AND NOT p.eon_id IS NULL\n    THEN 'BOTH'\n    WHEN NOT c.eon_id IS NULL\n    THEN 'ONLY_OCT'\n    ELSE 'ONLY_SEP'\n  END AS grp,\n  COUNT(*) AS apps,\n  SUM(c.n) AS oct_num,\n  SUM(c.d) AS oct_den,\n  SUM(p.n) AS sep_num,\n  SUM(p.d) AS sep_den,\n  COUNT_IF(\n    c.s = 'Non_Compliant'\n    AND COALESCE(p.s, '') <> 'Non_Compliant'\n    AND NOT p.eon_id IS NULL\n  ) AS newly_nc,\n  COUNT_IF(p.s = 'Non_Compliant' AND c.s <> 'Non_Compliant') AS resolved,\n  COUNT_IF(p.s = 'Non_Compliant' AND c.s = 'Non_Compliant') AS persistent\nFROM c\nFULL OUTER JOIN p\n  ON c.eon_id = p.eon_id\nGROUP BY\n  1 /* Generated by Cortex */;",
