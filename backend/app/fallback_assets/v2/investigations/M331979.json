        "sql": "WITH __obs AS (\n  SELECT\n    compliance_status,\n    metric_id,\n    reporting_monthend_date,\n    is_denominator AS denominator_flag,\n    is_numerator AS numerator_flag\n  FROM METRICS_ANALYZER.MOCK_DATA.APPLICATION_COMPLIANCE\n)\nSELECT\n  reporting_monthend_date,\n  COUNT(metric_id) AS metric_rows,\n  SUM(numerator_flag) AS numerator_total,\n  SUM(denominator_flag) AS denominator_total,\n  SUM(numerator_flag) / NULLIF(NULLIF(SUM(denominator_flag), 0), 0) AS provisional_rate,\n  COUNT_IF(compliance_status = 'Non_Compliant') AS non_compliant_rows\nFROM __obs\nWHERE\n  metric_id = 'M331979'\nGROUP BY\n  reporting_monthend_date\nORDER BY\n  reporting_monthend_date /* Generated by Cortex */;",
