        "sql": "WITH __obs AS (\n  SELECT\n    compliance_status,\n    metric_id,\n    reporting_monthend_date,\n    is_denominator AS denominator_flag,\n    is_numerator AS numerator_flag\n  FROM METRICS_ANALYZER.MOCK_DATA.APPLICATION_COMPLIANCE\n)\nSELECT\n  o.reporting_monthend_date AS m,\n  SUM(o.numerator_flag) AS num,\n  SUM(o.denominator_flag) AS den,\n  SUM(o.numerator_flag) / NULLIF(NULLIF(SUM(o.denominator_flag), 0), 0) AS provisional_rate,\n  COUNT(o.metric_id) AS rows_n,\n  COUNT_IF(o.compliance_status = 'Non_Compliant') AS nc_rows,\n  COUNT_IF(o.compliance_status = 'Pending') AS pending_rows\nFROM __obs AS o\nWHERE\n  o.metric_id = 'M333387'\nGROUP BY\n  1\nORDER BY\n  1 DESC /* Generated by Cortex */;",
