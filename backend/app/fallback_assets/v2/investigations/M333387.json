        "sql": "WITH __obs AS (\n  SELECT\n    compliance_reason,\n    compliance_status,\n    exemption_level_1,\n    metric_id,\n    test_result,\n    test_status,\n    eon_id,\n    reporting_monthend_date,\n    is_denominator AS denominator_flag,\n    is_numerator AS numerator_flag\n  FROM METRICS_ANALYZER.MOCK_DATA.APPLICATION_COMPLIANCE\n), __app_month AS (\n  SELECT\n    application_name,\n    division,\n    eon_id,\n    legal_entity_name,\n    movement_status,\n    super_division,\n    reporting_monthend_date\n  FROM METRICS_ANALYZER.MOCK_DATA.V_APPLICATION_MONTH_STATUS\n)\nSELECT\n  o.reporting_monthend_date AS m,\n  o.eon_id,\n  a.application_name,\n  a.super_division,\n  a.division,\n  a.legal_entity_name,\n  o.compliance_status,\n  o.compliance_reason,\n  o.test_status,\n  o.test_result,\n  o.exemption_level_1,\n  o.numerator_flag,\n  o.denominator_flag,\n  a.movement_status\nFROM __obs AS o\nLEFT JOIN __app_month AS a\n  ON o.eon_id = a.eon_id AND o.reporting_monthend_date = a.reporting_monthend_date\nWHERE\n  o.metric_id = 'M333387'\n  AND o.reporting_monthend_date IN ('2026-10-31', '2026-09-30')\nORDER BY\n  m DESC,\n  o.compliance_status,\n  o.eon_id /* Generated by Cortex */;",
