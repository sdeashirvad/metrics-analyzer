        "sql": "WITH __obs AS (\n  SELECT\n    compliance_status,\n    metric_id,\n    eon_id,\n    reporting_monthend_date,\n    is_denominator AS denominator_flag,\n    is_numerator AS numerator_flag\n  FROM METRICS_ANALYZER.MOCK_DATA.APPLICATION_COMPLIANCE\n), c AS (\n  SELECT\n    eon_id,\n    compliance_status AS s,\n    numerator_flag AS n,\n    denominator_flag AS d\n  FROM __obs\n  WHERE\n    metric_id = 'M314650' AND reporting_monthend_date = '2026-10-31'\n), p AS (\n  SELECT\n    eon_id,\n    compliance_status AS s,\n    numerator_flag AS n,\n    denominator_flag AS d\n  FROM __obs\n  WHERE\n    metric_id = 'M314650' AND reporting_monthend_date = '2026-09-30'\n)\nSELECT\n  CASE\n    WHEN NOT c.eon_id IS NULL AND NOT p.eon_id IS NULL\n    THEN 'BOTH'\n    WHEN NOT c.eon_id IS NULL\n    THEN 'ONLY_OCT'\n    ELSE 'ONLY_SEP'\n  END AS grp,\n  CASE\n    WHEN c.eon_id IS NULL\n    THEN NULL\n    WHEN p.eon_id IS NULL\n    THEN 'NO_PRIOR_MONTH'\n    WHEN c.s = 'Non_Compliant' AND p.s <> 'Non_Compliant'\n    THEN 'NEWLY_NON_COMPLIANT'\n    WHEN c.s <> 'Non_Compliant' AND p.s = 'Non_Compliant'\n    THEN 'RESOLVED'\n    WHEN c.s = 'Non_Compliant' AND p.s = 'Non_Compliant'\n    THEN 'PERSISTENT_NON_COMPLIANT'\n    ELSE 'OTHER'\n  END AS mv,\n  COUNT(*) AS apps,\n  SUM(c.n) AS cur_num,\n  SUM(c.d) AS cur_den,\n  SUM(p.n) AS prev_num,\n  SUM(p.d) AS prev_den\nFROM c\nFULL OUTER JOIN p\n  ON c.eon_id = p.eon_id\nGROUP BY\n  1,\n  2\nORDER BY\n  1,\n  2 /* Generated by Cortex */;",
