        "sql": "WITH __obs AS (\n  SELECT\n    compliance_status,\n    metric_id,\n    test_result,\n    test_status,\n    eon_id,\n    reporting_monthend_date,\n    is_denominator AS denominator_flag,\n    is_numerator AS numerator_flag\n  FROM METRICS_ANALYZER.MOCK_DATA.APPLICATION_COMPLIANCE\n)\nSELECT\n  o.reporting_monthend_date AS m,\n  COUNT(o.metric_id) AS rows_n,\n  COUNT(DISTINCT o.eon_id) AS apps,\n  SUM(o.numerator_flag) AS num,\n  SUM(o.denominator_flag) AS den,\n  SUM(o.numerator_flag) / NULLIF(NULLIF(SUM(o.denominator_flag), 0), 0) AS rate,\n  COUNT_IF(o.compliance_status = 'Non_Compliant') AS nc,\n  COUNT_IF(o.compliance_status = 'Compliant') AS c,\n  COUNT_IF(o.compliance_status = 'Pending') AS p,\n  COUNT_IF(o.compliance_status = 'Not_Applicable') AS na,\n  COUNT_IF(o.test_status = 'Test_Complete') AS tc,\n  COUNT_IF(o.test_status = 'Test_Complete' AND o.test_result = 'Fail') AS tf,\n  COUNT_IF(o.test_status = 'Test_Pending') AS tp,\n  COUNT_IF(o.test_status = 'No_Test') AS nt,\n  COUNT_IF(o.test_status = 'Exempt') AS ex\nFROM __obs AS o\nWHERE\n  o.metric_id = 'M325951'\nGROUP BY\n  1\nORDER BY\n  1 /* Generated by Cortex */;",
